# ── 商家智能运营 Agent 配置模板（by 31）──────────────────────────
# 用法：把本文件复制成同名去掉 .example 的文件（即 .env），按需取消注释填写。
# 已经存在的系统环境变量优先级更高，不会被本文件覆盖。

# ── 1. 模型：三选一 ─────────────────────────────────────────────

# 方案 A：DeepSeek（推荐，国内直连、便宜）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 方案 B：任意 OpenAI 兼容服务
# 把下面 LLM_PROFILE 改成 compat 才会启用
LLM_PROFILE=cloud
COMPAT_API_KEY=
COMPAT_API_BASE=https://api.siliconflow.cn
COMPAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# 方案 C：本机 Ollama（LLM_PROFILE=local，需先 ollama serve）
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=qwen2:7b

# ── 2. 模型路由 ────────────────────────────────────────────────
# 逗号分隔表示兜底：前一个失败自动切下一个
# LLM_CHAIN=deepseek:deepseek-chat,compat:Qwen/Qwen2.5-7B-Instruct
# 也可以逐 Agent 覆盖：
# SELECTOR_MODEL=deepseek:deepseek-chat
# LISTER_MODEL=deepseek:deepseek-chat
# SERVICE_MODEL=deepseek:deepseek-chat
# ANALYST_MODEL=deepseek:deepseek-chat
# SOURCING_MODEL=deepseek:deepseek-chat
# COMPLIANCE_MODEL=deepseek:deepseek-chat
# FAST_MODEL=deepseek:deepseek-chat

# ── 3. 运行参数 ────────────────────────────────────────────────
WEB_PORT=7860
AGENT_TIMEOUT=300
CONNECT_TIMEOUT=10
MAX_RETRIES=2
REACT_MAX_ROUNDS=8
LOG_LEVEL=INFO

# 缓存
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_CAPACITY=200

# ── 4. 平台 ────────────────────────────────────────────────────
# taobao / pdd / douyin
DEFAULT_PLATFORM=taobao

# ── 5. 存储 ────────────────────────────────────────────────────
# 默认 sqlite（data/merchant.db），无需其它服务
CONVERSATION_BACKEND=sqlite
